# showcase/index: this branch defaults to index and Third Shot.
# Replace example domains before building; these are public, build-time settings.
THEME=index
NEXT_PUBLIC_API_URL=https://api.thirdshot.example/api/v1
NEXT_PUBLIC_SITE_URL=https://index.thirdshot.example
NEXT_PUBLIC_BRAND_NAME=Third Shot
NEXT_PUBLIC_BRAND_TAGLINE=Đồ pickleball chính hãng cho mọi trình độ
NEXT_PUBLIC_BRAND_DESCRIPTION=Vợt, bóng, giày và trang phục pickleball chính hãng — tư vấn chọn vợt tận tình, giao nhanh toàn quốc.
# Set your real contact number if needed (optional).
# NEXT_PUBLIC_PHONE_NUMBER=
