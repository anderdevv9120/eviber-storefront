{
  "name": "aib_ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint . --max-warnings 0",
    "lint:write": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006 -c storybook",
    "build-storybook": "storybook build -c storybook -o storybook/.out"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,tsx}": "bash -c 'tsc --skipLibCheck --strict --noEmit'"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "immer": "^10.2.0",
    "js-cookie": "^3.0.8",
    "next": "^16.3.8",
    "qs": "^6.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.82.0",
    "react-swipeable": "^7.0.2",
    "react-toastify": "^10.0.6",
    "sass": "^1.101.6",
    "tailwind-merge": "^2.6.1",
    "yup": "^1.7.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.43",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "storybook": "^10.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  }
}
